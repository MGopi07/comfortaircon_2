# Comfort Aircon Environment Configuration
# Set the active backend API base URL for your target environment:

# 1. Local Backend Development:
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# 2. Remote Development:
# NEXT_PUBLIC_API_BASE_URL=https://dev.api.comfortair.co.in/api/v1

# 3. Staging Environment:
# NEXT_PUBLIC_API_BASE_URL=https://staging.api.comfortair.co.in/api/v1

# 4. Production Environment:
NEXT_PUBLIC_API_BASE_URL=https://api.comfortair.co.in/api/v1
